# ESP32-S3 根本性IRAM优化配置
# 目标：将IRAM使用降低到16KB物理限制以内

# ==================== LVGL优化 ====================
# 完全禁用LVGL的IRAM使用 (节省 21.4 KB)
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=n
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_SIZE=262144
CONFIG_LV_MEM_ADR=0

# ==================== FreeRTOS优化 ====================  
# 将FreeRTOS函数移到Flash (节省 ~7 KB，保留关键ISR)
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_FREERTOS_PLACE_SNAPSHOT_FUNS_INTO_FLASH=y

# ==================== HAL层优化 ====================
# 减少HAL层的IRAM使用 (节省 ~6 KB)
CONFIG_HAL_DEFAULT_ASSERTION_LEVEL=0
CONFIG_HAL_LOG_LEVEL=0

# ==================== ESP系统优化 ====================
# 系统组件移到Flash
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
CONFIG_ESP_DEBUG_STUBS_ENABLE=n
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=16
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2048

# ==================== 硬件支持优化 ====================
# ESP硬件支持库优化 (节省 ~10 KB)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# ==================== 内存管理优化 ====================
# 堆管理移到Flash
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_HEAP_TASK_TRACKING=n
CONFIG_HEAP_POISONING_DISABLED=y

# ==================== SPI Flash优化 ====================
# SPI Flash驱动优化 (节省 ~6 KB)
CONFIG_SPI_FLASH_ROM_DRIVER_PATCH=n
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ABORTS=n
CONFIG_SPI_FLASH_DANGEROUS_WRITE_FAILS=n
CONFIG_SPI_FLASH_USE_LEGACY_IMPL=n

# SPI Master优化
CONFIG_SPI_MASTER_IN_IRAM=n
CONFIG_SPI_MASTER_ISR_IN_IRAM=n

# ==================== 驱动优化 ====================
# 通用驱动优化
CONFIG_DRIVER_PCNT_ISR_IRAM_SAFE=n
CONFIG_DRIVER_UART_ISR_IRAM_SAFE=n
CONFIG_DRIVER_SPI_MASTER_ISR_IRAM_SAFE=n

# ==================== 标准库优化 ====================
# NewLib优化
CONFIG_NEWLIB_NANO_FORMAT=y

# ==================== 环型缓冲区优化 ====================
CONFIG_ESP_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y

# ==================== PSRAM配置 ====================
# 最大化使用PSRAM
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ==================== Cache配置优化 ====================
# 优化Cache以支持Flash执行
CONFIG_ESP32S3_INSTRUCTION_CACHE_SIZE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_SIZE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_8WAYS=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_32B=y
CONFIG_ESP32S3_DATA_CACHE_LINE_32B=y

# ==================== 编译器优化 ====================
# 代码大小优化
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# ==================== 调试和日志优化 ====================
# 减少调试开销
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_LOG_MAXIMUM_LEVEL=3

# ==================== 网络协议栈优化 ====================
# 如果不需要网络功能，完全禁用
# CONFIG_ESP_NETIF_TCPIP_ADAPTER_COMPATIBLE_LAYER=n

# ==================== 其他优化 ====================
# 减少其他组件的IRAM使用
CONFIG_ESP_TIMER_IMPL_SYSTIMER=y
CONFIG_ESP_TIMER_INTERRUPT_LEVEL=1

# Bootloader优化
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# 定时器优化
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3072

# 事件循环优化
CONFIG_ESP_EVENT_LOOP_PROFILING=n

# ==================== 应用特定优化 ====================
# 根据你的应用需求调整
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# ==================== 验证配置 ====================
# 确保关键功能仍然可用
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_REV_MIN_FULL=0
